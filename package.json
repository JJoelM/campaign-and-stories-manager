{
  "name": "thyrenia-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor Narrativo FSM, Compilador de Niebla de Guerra Estratificada y Harness Especializado de Gemini para Thyrenia",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --exclude test/evals/**",
    "test:watch": "vitest --exclude test/evals/**",
    "test:evals": "vitest run test/evals",
    "harness": "tsx src/cli/workbench.ts",
    "harness:models": "tsx src/cli/check-models.ts",
    "security:audit": "tsx src/cli/security-audit.ts",
    "web": "tsx src/web/server.ts",
    "web:build": "vite build",
    "web:dev": "vite"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.1.0",
    "ai": "^4.1.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
