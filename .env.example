# ============================================================================
# THYRENIA ENGINE - CONFIGURACIÓN DE ENTORNO Y SEGURIDAD
# NUNCA subas tu archivo .env real a ningún repositorio.
# ============================================================================

# Clave de Google AI Studio (Sólo entorno servidor local, nunca exponer en cliente)
GEMINI_API_KEY="TU_CLAVE_AQUI"

# Ruta absoluta al Vault Maestro de Obsidian (ADR-0006)
VAULT_PATH="G:/Otros ordenadores/Mi PC/Google Drive/Thyrenia"

# Modo del Harness: "replay" (offline determinista, coste 0) | "record" (graba fixtures sanitizadas) | "live"
HARNESS_MODE="replay"

# Modelos vigentes en Google AI Studio (Familias Gemini 4 y Gemini 3.8/3.5)
GEMINI_FAST_LOOP_MODEL="gemini-3.8-flash"
GEMINI_REASONING_MODEL="gemini-4-argon"
GEMINI_CANON_MODEL="gemini-4-carbon"
GEMINI_EVAL_JUDGE_MODEL="gemini-decision-1"

# Límites de Ciberseguridad y Control de Cuota (ADR-0011)
MAX_PLAYER_INPUT_CHARS="1000"
MAX_REQUESTS_PER_MINUTE="20"
MAX_OUTPUT_TOKENS="2048"

# Player Web App & Modo GM (ADR-0001, ADR-0009)
PORT="3000"
GM_ACCESS_KEY="thyrenia-gm"
